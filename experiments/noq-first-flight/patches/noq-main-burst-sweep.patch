diff --git a/noq-proto/src/tests/first_flight.rs b/noq-proto/src/tests/first_flight.rs
new file mode 100644
index 0000000..b461f22
--- /dev/null
+++ b/noq-proto/src/tests/first_flight.rs
@@ -0,0 +1,171 @@
+//! External diagnostic: large TLS messages traversing a small deterministic queue.
+//! This deliberately isolates queue capacity, rather than simulating a competing CUBIC flow.
+use super::*;
+
+#[derive(Debug, PartialEq, Eq)]
+struct Outcome {
+    handshake_us: u128,
+    lost: u64,
+    crypto_frames: u64,
+}
+
+fn simulate(padding: bool, budget: u64, queue_bytes: u32, seed: u8) -> Outcome {
+    let mut params = rcgen::CertificateParams::new(vec!["localhost".into()]).unwrap();
+    params.serial_number = Some(rcgen::SerialNumber::from(1u64));
+    params
+        .custom_extensions
+        .push(rcgen::CustomExtension::from_oid_content(
+            &[1, 3, 6, 1, 4, 1, 55555, 1],
+            vec![0x42; 5000],
+        ));
+    // Ed25519 fixes signature lengths; only the large TLS flight matters here.
+    // Fixed test-only seed encoded as PKCS#8, so the certificate is identical on every run.
+    let mut key_der = hex!("302e020100300506032b657004220420").to_vec();
+    key_der.extend_from_slice(&[7; 32]);
+    let key = rcgen::KeyPair::from_pkcs8_der_and_sign_algo(
+        &PrivatePkcs8KeyDer::from(key_der),
+        &rcgen::PKCS_ED25519,
+    )
+    .unwrap();
+    let cert = params.self_signed(&key).unwrap();
+    let mut endpoint_config = EndpointConfig::default();
+    endpoint_config.rng_seed(Some([seed; 32]));
+    let mut transport = TransportConfig::default();
+    transport.deterministic_packet_numbers(true);
+    transport.mtu_discovery_config(None);
+    let transport = Arc::new(transport);
+    let mut server = server_config_with_cert(
+        cert.der().clone(),
+        PrivatePkcs8KeyDer::from(key.serialize_der()).into(),
+    );
+    server.transport = transport.clone();
+    let mut client = client_config_with_certs(vec![cert.der().clone()]);
+    client.transport = transport;
+    let mut pair = Pair::new(Arc::new(endpoint_config), server);
+    pair.routes = BwLimitedRouting::new(
+        Pair::CLIENT_ADDR,
+        Pair::SERVER_ADDR,
+        pair.time,
+        BwLimitConfig {
+            bytes_per_second: 1_250_000,
+            buffer_size: queue_bytes,
+            latency: Duration::from_millis(50),
+        },
+    )
+    .into();
+    pair.server.prototype_first_flight = Some((padding, budget));
+    let client_ch = pair.begin_connect(client);
+    pair.client_conn_mut(client_ch)
+        .prototype_first_flight_for_test(padding, budget);
+    let start = pair.time;
+    let server_ch = loop {
+        pair.drive_client();
+        pair.drive_server();
+        assert!(
+            !pair.client_conn_mut(client_ch).is_closed(),
+            "client closed"
+        );
+        if let Some(Ok(server_ch)) = pair.server.accepted {
+            assert!(
+                !pair.server_conn_mut(server_ch).is_closed(),
+                "server closed"
+            );
+            if !pair.client_conn_mut(client_ch).is_handshaking()
+                && !pair.server_conn_mut(server_ch).is_handshaking()
+            {
+                break server_ch;
+            }
+        }
+        assert!(
+            pair.time.duration_since(start) < Duration::from_secs(5),
+            "handshake stuck"
+        );
+        assert!(pair.advance_time(), "no wakeup before handshake completed");
+    };
+    let handshake_us = pair.time.duration_since(start).as_micros();
+    // Drain ACKs so loss accounting includes the completed handshake.
+    pair.drive();
+    pair.finish_connect(client_ch, server_ch);
+    let client_stats = pair.client_conn_mut(client_ch).stats();
+    let server_stats = pair.server_conn_mut(server_ch).stats();
+    let stream = pair.client_streams(client_ch).open(Dir::Uni).unwrap();
+    let payload = b"authenticated data after the queued handshake";
+    assert_eq!(
+        pair.client_send(client_ch, stream).write(payload).unwrap(),
+        payload.len()
+    );
+    pair.client_send(client_ch, stream).finish().unwrap();
+    pair.drive();
+    assert_eq!(
+        pair.server_streams(server_ch).accept(Dir::Uni),
+        Some(stream)
+    );
+    let mut recv = pair.server_recv(server_ch, stream);
+    let mut chunks = recv.read(false).unwrap();
+    assert_eq!(
+        chunks.next(usize::MAX).unwrap().unwrap().bytes.as_ref(),
+        payload
+    );
+    assert!(chunks.next(usize::MAX).unwrap().is_none());
+    let _ = chunks.finalize();
+    Outcome {
+        handshake_us,
+        lost: client_stats.lost_packets + server_stats.lost_packets,
+        crypto_frames: client_stats.frame_tx.crypto + server_stats.frame_tx.crypto,
+    }
+}
+
+#[test]
+fn diagnostic_first_flight_queue_sweep() {
+    for queue in [1200, 2400, 3600, 9600] {
+        for (padding, budget) in [
+            (false, 0),
+            (true, 0),
+            (true, 2400),
+            (true, 4800),
+            (true, 9600),
+        ] {
+            let a = simulate(padding, budget, queue, 7);
+            let b = simulate(padding, budget, queue, 7);
+            assert_eq!(a, b, "same seeded scenario should have the same outcome");
+            println!(
+                "QUEUE_RESULT queue_bytes={queue} padding={padding} budget={budget} us={} lost={} crypto={}",
+                a.handshake_us, a.lost, a.crypto_frames
+            );
+        }
+    }
+}
+
+#[test]
+fn first_flight_small_queue_burst_regression() {
+    for seed in [0, 1, 7, 42] {
+        let control = simulate(false, 0, 2400, seed);
+        let large = simulate(true, 9600, 2400, seed);
+        let small = simulate(true, 2400, 2400, seed);
+        assert_eq!(large, simulate(true, 9600, 2400, seed));
+        assert_eq!(control.lost, 0);
+        assert!(large.lost > 0);
+        assert!(large.handshake_us > control.handshake_us);
+        assert_eq!(small.lost, 0);
+        assert!(small.handshake_us < control.handshake_us);
+    }
+}
+
+#[test]
+fn first_flight_smaller_burst_is_not_universally_safe() {
+    let control = simulate(false, 0, 1200, 7);
+    let small = simulate(true, 2400, 1200, 7);
+    assert_eq!(control.lost, 0);
+    assert!(small.lost > 0);
+    assert!(small.handshake_us > control.handshake_us);
+}
+
+#[test]
+fn first_flight_roomy_queue_rewards_larger_burst() {
+    let control = simulate(false, 0, 9600, 7);
+    let small = simulate(true, 2400, 9600, 7);
+    let large = simulate(true, 9600, 9600, 7);
+    assert_eq!(large.lost, 0);
+    assert!(large.handshake_us < small.handshake_us);
+    assert!(small.handshake_us < control.handshake_us);
+}
