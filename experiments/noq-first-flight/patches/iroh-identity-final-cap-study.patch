+#[cfg(test)]
+mod flight_hint_tests {
+    use super::*;
+
+    #[test]
+    fn selects_only_exclusive_ml_dsa65_policy() {
+        assert!(large_server_flight_expected(&[SignatureScheme::ML_DSA_65]));
+        for schemes in [
+            vec![],
+            vec![SignatureScheme::ED25519],
+            vec![SignatureScheme::ED25519, SignatureScheme::ML_DSA_65],
+            vec![SignatureScheme::Unknown(0xfeff)],
+            vec![SignatureScheme::ML_DSA_65, SignatureScheme::Unknown(0xfeff)],
+        ] {
+            assert!(!large_server_flight_expected(&schemes), "{schemes:?}");
+        }
+    }
