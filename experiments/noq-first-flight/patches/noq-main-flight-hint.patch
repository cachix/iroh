+//! Diagnostic repeated Initials with the unmodified pacer.
+use super::*;
+use super::util::client_crypto;
+
+fn initial_pair(repeat: bool, rate: Option<u64>) -> (Pair, ConnectionHandle) {
+    let mut pair = Pair::default();
+    let mut transport = TransportConfig::default();
+    transport.max_outgoing_bytes_per_second(rate);
+    transport.mtu_discovery_config(None);
+    let mut crypto = client_crypto();
+    if repeat {
+        crypto.large_server_flight_expected(true);
+    }
+    let mut config = ClientConfig::new(Arc::new(crypto));
+    config.transport_config(Arc::new(transport));
+    let client = pair.begin_connect(config);
+    (pair, client)
+}
+
+fn collect_initials(pair: &mut Pair, client: ConnectionHandle) {
+    let start = pair.time;
+    pair.drive_client();
+    // Repetition must not bypass the pacer to send two datagrams immediately.
+    assert_eq!(pair.server.inbound.len(), 1);
+    while pair.server.inbound.len() < 2 {
+        // Do not let the server consume either packet yet. Advance only to the
+        // client's pacing timer, not to the queued server receive time.
+        let wakeup = pair.client.next_wakeup().expect("pending repeated Initial");
+        assert!(wakeup > pair.time);
+        pair.time = wakeup;
+        pair.drive_client();
+        assert!(
+            pair.time - start < Duration::from_millis(999),
+            "reached initial PTO"
+        );
+    }
+    assert_eq!(pair.server.inbound.len(), 2);
+    assert_eq!(pair.client_conn_mut(client).stats().frame_tx.crypto, 2);
+    assert_eq!(pair.server.inbound[0].packet.len(), 1200);
+    assert_eq!(pair.server.inbound[1].packet.len(), 1200);
+    assert_ne!(pair.server.inbound[0].packet, pair.server.inbound[1].packet);
+}
+
+#[test]
+fn repeated_initial_survives_either_packet_lost() {
+    for drop_first in [true, false] {
+        let (mut pair, client) = initial_pair(true, None);
+        collect_initials(&mut pair, client);
+        if drop_first {
+            pair.server.inbound.pop_first().unwrap();
+        } else {
+            pair.server.inbound.pop_last().unwrap();
+        }
+        pair.drive_server();
+        let server = pair.server.assert_accept();
+        assert!(pair.server_conn_mut(server).stats().frame_tx.crypto > 0);
+        pair.drive();
+        pair.finish_connect(client, server);
+    }
+}
+
+#[test]
+fn repeated_initial_handles_reordering() {
+    let (mut pair, client) = initial_pair(true, None);
+    collect_initials(&mut pair, client);
+    let (_, first) = pair.server.inbound.pop_first().unwrap();
+    let (_, last) = pair.server.inbound.pop_last().unwrap();
+    pair.server.inbound.push(pair.time, last);
+    pair.server.inbound.push(pair.time, first);
+    pair.drive();
+    let server = pair.server.assert_accept();
+    pair.finish_connect(client, server);
+}
+
+#[test]
+fn repeated_initial_respects_explicit_rate_cap() {
+    let (mut pair, client) = initial_pair(true, Some(12_000));
+    let start = pair.time;
+    collect_initials(&mut pair, client);
+    // Check a conservative lower bound on the pacing delay with a rate cap.
+    // This does not assert the exact configured rate or token refill timing.
+    assert!(pair.time - start >= Duration::from_millis(80));
+    pair.drive();
+    let server = pair.server.assert_accept();
+    pair.finish_connect(client, server);
+}
+
+#[test]
+fn repeated_initial_disabled_keeps_single_initial() {
+    let (mut pair, client) = initial_pair(false, None);
+    pair.drive_client();
+    assert_eq!(pair.server.inbound.len(), 1);
+    assert_eq!(pair.client_conn_mut(client).stats().frame_tx.crypto, 1);
+    pair.drive();
+    let server = pair.server.assert_accept();
+    pair.finish_connect(client, server);
+}
